# Kutirchar EcoFarm - Environment Variables

# General
NODE_ENV=development
APP_NAME=Kutirchar EcoFarm
DEBUG=true

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/kutirchar_ecofarm

# Authentication
AUTH_SECRET=your_auth_secret_here
API_KEY=your_api_key_here

# Third-party APIs
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key

# Email Service
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_password

# File Storage
STORAGE_BUCKET=kutirchar-ecofarm
STORAGE_REGION=us-east-1

# Monitoring
SENTRY_DSN=

# Site Configuration
SITE_URL=https://kuticshareecofarm.com
